// Configuración del Worker "web" de Cloudflare (sitio público de Rita Poma).
// Publicar desde esta carpeta (web/):  npx wrangler deploy
// Cada publicación reemplaza TODO el contenido anterior por lo que hay en publico/.
{
  "name": "web",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./publico",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true
}
